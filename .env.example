# MindCursor — copy to .env and fill in real values. Never commit .env.
# Postgres — from Vercel Marketplace (Neon) or Render / Neon.
# Vercel injects POSTGRES_URL; Render / Neon use DATABASE_URL.
DATABASE_URL=postgresql://user:password@host:5432/mindcursor
POSTGRES_URL=postgresql://user:password@host:5432/mindcursor

# Admin account (seeded by init_db on first run). Change in production.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Must match the client-side pepper.
PW_PEPPER=mindcursor$

# Email (Gmail SMTP) — optional. If unset, /api/results/notify logs and skips.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
